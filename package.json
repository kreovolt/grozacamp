{
  "name": "groza-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-assets.mjs",
    "test": "node scripts/php.mjs vendor/bin/phpunit",
    "e2e": "playwright test",
    "photos": "node scripts/optimize-photos.mjs",
    "deploy": "node scripts/deploy.mjs",
    "lint:php": "node scripts/php.mjs vendor/bin/phpcs --runtime-set installed_paths vendor/phpcompatibility/php-compatibility,vendor/phpcsstandards/phpcsutils",
    "lint:syntax": "node scripts/lint-syntax.mjs",
    "test:node": "node --test tests/node/scripts.test.mjs",
    "lint": "npm run lint:syntax && npm run lint:php",
    "export:pages": "node scripts/export-pages.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "basic-ftp": "^6.2.6",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.1",
    "lucide-static": "^1.80.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "trix": "^2.1.19"
  }
}
