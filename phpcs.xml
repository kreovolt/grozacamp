<?xml version="1.0"?>
<ruleset name="Groza PHP 8.1 compatibility">
  <description>Совместимость с PHP 8.1 (хостинг); платформа composer — 8.1.0.</description>
  <config name="testVersion" value="8.1"/>
  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="p"/>
  <file>app</file>
  <file>config</file>
  <file>scripts</file>
  <file>templates</file>
  <file>public/index.php</file>
  <rule ref="PHPCompatibility"/>
</ruleset>
