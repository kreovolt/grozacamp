{
  "name": "groza/site",
  "description": "Сайт детского лагеря «Гроза» (grozacamp.ru)",
  "type": "project",
  "require": {
    "phpmailer/phpmailer": "^7.2",
    "symfony/html-sanitizer": "^6.4"
  },
  "autoload": {
    "psr-4": { "Groza\\": "app/" }
  },
  "autoload-dev": {
    "psr-4": { "Groza\\Tests\\": "tests/php/" }
  },
  "config": {
    "platform": { "php": "8.1.0" },
    "sort-packages": true
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  }
}
